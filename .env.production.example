# ─── Copy these into Vercel Dashboard → Project → Settings → Environment Variables ───
#
# REQUIRED for demo mode (no Supabase needed)
NEXT_PUBLIC_DEMO_MODE=true

# App URL — Vercel sets this automatically via next.config.mjs, but add manually if needed:
# NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# ─── OPTIONAL: only needed for real production (non-demo) ───────────────────────────

# Supabase — create a project at supabase.com
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Anthropic AI — for real AI Tutor responses (optional; demo uses canned responses)
# ANTHROPIC_API_KEY=sk-ant-...

# Stripe — for real subscription billing (optional; demo shows free tier)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
