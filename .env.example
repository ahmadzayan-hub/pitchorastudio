# =====================================================
# Pitchora — environment variables
# Copy this file to .env.local and fill only the vars for the
# services you actually want to connect. Everything else falls back
# to a safe default (mock provider, 503 for billing, etc.).
# =====================================================

# --- Public app URL (required) ---
# Local dev is fine as-is. Production must be the real HTTPS URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Demo mode (recommended for first-run / previews) ---
# When true, the API + UI serve deterministic sample data and skip
# every external integration (Supabase, LLM providers, Stripe). Set
# this on Preview deployments. Never set it on Production.
NEXT_PUBLIC_DEMO_MODE=true

# --- Supabase (leave blank to run in demo mode only) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Admin routes fail
# closed with HTTP 503 when this is missing (see THREAT_MODEL.md G2).
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (leave blank to use the deterministic mock) ---
# Supported: "anthropic" | "openai" | "ollama". If unset OR the
# corresponding key is missing, Pitchora runs its Mock provider so
# the wizard end-to-end still works with sample content.
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=

# --- Stripe (leave blank to disable billing) ---
# Billing endpoints return HTTP 503 (stripe_not_configured) when
# STRIPE_SECRET_KEY is missing. Webhook signature is enforced when
# STRIPE_WEBHOOK_SECRET is set (never accept unsigned webhooks).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe price IDs (per plan, monthly + annual)
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=

# --- Email (optional) ---
EMAIL_FROM=
RESEND_API_KEY=
